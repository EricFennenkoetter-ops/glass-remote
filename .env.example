# Client ID aus dem Spotify Developer Dashboard (kein Geheimnis – PKCE braucht kein Client Secret)
VITE_SPOTIFY_CLIENT_ID=

# Muss exakt (inkl. abschließendem /) einer Redirect-URI im Dashboard entsprechen.
# Lokal:      http://127.0.0.1:5173/
# Produktion: https://<dein-name>.github.io/<repo>/   bzw.  https://<projekt>.vercel.app/
# Leer lassen = aktuelle Seiten-URL wird verwendet.
VITE_REDIRECT_URI=http://127.0.0.1:5173/
